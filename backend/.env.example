# Copy to backend/.env and edit if you want to change defaults. Every key is optional.
# Paths are resolved automatically for this bundle layout (models/ next to backend/), so nothing is required here.

# --- component 1: skin / relevance gate ----------------------------------
RELEVANCE_BACKEND=vlm             # vlm (default: the second reader decides, nothing extra to download)
                                  # | clip (CLIP zero-shot, run download_models.py --with-clip) | clip+vlm
RELEVANCE_THRESHOLD=0.50

# --- component 2: disease-likelihood classifier --------------------------
LIKELIHOOD_MODE=ensemble          # ensemble (T11+T09+T05, validation-selected weights) | single (T11 only)
LIKELIHOOD_TTA=false              # 4-view test-time augmentation (4x cost)
CONFIDENCE_THRESHOLD=0.60         # confidence gate -> review_required
ESCALATION_THRESHOLD=0.20         # zero-miss operating point on 1 - P(Normal)

# --- component 3: abnormality localisation (fusion segmenter) ------------
VAIS_BACKEND=fusion               # fusion (VLM grounding + Grounding DINO + classifier attention -> SAM 2.1) | gdino_sam | none
VAIS_MASK_MODEL=facebook/sam2.1-hiera-small
VAIS_INSTANCE_REVIEW=true         # second reader reviews each numbered region and the overlay as a whole
VAIS_DEVICE_POLICY=gpu_on_demand  # cpu | gpu_on_demand | gpu_resident

# --- component 4: vision-language model ----------------------------------
VLM_BACKEND=qwen3vl               # qwen3vl (default) | medgemma (gated; download_models.py --with-medgemma) | none
VLM_QWEN_ID=Qwen/Qwen3-VL-4B-Instruct
VLM_4BIT=true                     # NF4 quantisation (required for a 6 GB GPU; set false on 12 GB+ for speed)
VLM_MAX_NEW_TOKENS=600

# --- service -------------------------------------------------------------
DEVICE=auto                       # auto | cuda | cpu
WARMUP_ON_START=true
HF_HUB_OFFLINE=false              # true = never contact the Hugging Face Hub (all models already in models/hf_cache)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
